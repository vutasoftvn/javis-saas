FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Build context is the repo root (see docker-compose.yml) so this image can
# assemble the pre-restructure `backend/` layout: `legacy/backend` (this app)
# plus `legacy/agent_runtime`'s workforce/cosa_core/agent_runtime packages,
# which legacy/backend's own code imports as top-level packages
# (`from workforce...`, `from cosa_core...`, `from agent_runtime...`).
COPY legacy/backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY legacy/backend/ .
COPY legacy/agent_runtime/workforce ./workforce
COPY legacy/agent_runtime/cosa_core ./cosa_core
COPY legacy/agent_runtime/agent_runtime ./agent_runtime

RUN pip install -e ./cosa_core

EXPOSE 8000


CMD ["sh", "-c", "alembic upgrade head 2>/dev/null || true; uvicorn main:app --host 0.0.0.0 --port 8000"]

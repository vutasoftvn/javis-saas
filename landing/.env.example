# Resend API Configuration for Early Access Email Delivery
# Lấy API Key tại: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Địa chỉ gửi email (Nếu dùng domain mặc định của Resend để test: onboarding@resend.dev)
RESEND_FROM_EMAIL="COSA OS <onboarding@resend.dev>"

# Địa chỉ email nhận thông báo khi có người đăng ký Early Access mới
ADMIN_NOTIFICATION_EMAIL="founder@example.com"

# --- Persistence & abuse protection (bắt buộc ở production, xem
# src/lib/early-access-store.ts và src/lib/early-access-rate-limit.ts) ---

# Connection string Postgres riêng của landing (KHÔNG chia sẻ schema với
# services/company hay services/cosa) — dùng để lưu bền vững đăng ký Early
# Access và bộ đếm rate limit. Bảng tự tạo (migration-on-boot) khi ứng dụng
# khởi động lần đầu. Ở production, THIẾU biến này sẽ khiến app throw lỗi
# ngay lần request đầu tiên (fail loud) thay vì âm thầm dùng bộ nhớ tạm.
DATABASE_URL="postgres://user:password@localhost:5432/cosa_landing"

# Secret Key xác minh Cloudflare Turnstile (CAPTCHA) — lấy tại
# https://dash.cloudflare.com/?to=/:account/turnstile. Chỉ bắt buộc ở
# production; thiếu biến này ở production sẽ khiến request bị từ chối (fail
# loud) thay vì âm thầm bỏ qua bước chống bot.
TURNSTILE_SECRET_KEY="0x_your_turnstile_secret_key"

# --- Data retention & privacy (xem README.md mục "Quyền riêng tư & lưu trữ
# dữ liệu Early Access" để biết quy trình xoá dữ liệu theo yêu cầu) ---

# Số ngày lưu giữ dữ liệu đăng ký Early Access trước khi cần xoá/ẩn danh thủ
# công theo quy trình vận hành đã tài liệu hoá (chưa có pipeline tự động).
EARLY_ACCESS_RETENTION_DAYS="365"

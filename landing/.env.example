# Resend API Configuration for Early Access Email Delivery
# Lấy API Key tại: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Địa chỉ gửi email (Nếu dùng domain mặc định của Resend để test: onboarding@resend.dev)
RESEND_FROM_EMAIL="COSA OS <onboarding@resend.dev>"

# Địa chỉ email nhận thông báo khi có người đăng ký Early Access mới
ADMIN_NOTIFICATION_EMAIL="founder@example.com"

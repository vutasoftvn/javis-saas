# Template biến môi trường cho docker-compose.prod.yaml (ADR-DEPLOY-001).
# Copy → .env.prod, điền giá trị THẬT (không commit .env.prod).
# Mọi biến ${VAR:?required} trong compose PHẢI có giá trị, nếu không
# `docker compose config` sẽ fail (đúng thiết kế fail-closed — Part 1E/2D).
#
# Quản lý secret production: Coolify secrets (xem docs/operations/secrets.md).

# ---- Postgres (container chính) ----
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__change_me__
AGENT_APP_PASSWORD=__change_me__
AGENT_MIGRATOR_PASSWORD=__change_me__
COSA_APP_PASSWORD=__change_me__
COSA_MIGRATOR_PASSWORD=__change_me__
WORKSPACE_APP_PASSWORD=__change_me__
WORKSPACE_MIGRATOR_PASSWORD=__change_me__

# ---- Database URLs (app và migration; trỏ tới service `postgres` trong network nội bộ) ----
AGENT_DATABASE_URL=postgresql+asyncpg://agent_app:__change_me__@postgres:5432/agent
AGENT_MIGRATOR_DATABASE_URL=postgresql+asyncpg://agent_migrator:__change_me__@postgres:5432/agent
COSA_DATABASE_URL=postgresql://cosa_app:__change_me__@postgres:5432/cosa?sslmode=disable
COSA_MIGRATOR_DATABASE_URL=postgresql://cosa_migrator:__change_me__@postgres:5432/cosa?sslmode=disable
WORKSPACE_DATABASE_URL=postgresql://workspace_app:__change_me__@postgres:5432/workspace?sslmode=disable
WORKSPACE_MIGRATOR_DATABASE_URL=postgresql://workspace_migrator:__change_me__@postgres:5432/workspace?sslmode=disable

# ---- JWT secrets (đối xứng apps/cosa ↔ services/cosa) ----
PLATFORM_JWT_SECRET=__random_min_48_chars__
WORKER_SERVICE_JWT_SECRET=__random_min_32_chars__

# ---- COSA internal service-to-service (event pipeline + Copilot dispatch) ----
# Shared HMAC secret giữa services-company relay và cosa-api event intake (>= 32 chars)
COSA_LOCAL_SERVICE_SECRET=
# Service token services-company -> cosa-api copilot routes, và cosa-worker -> services-company callback
COSA_SERVICE_TOKEN=
# Service token cosa-api scheduler -> cosa-worker
COSA_WORKER_SERVICE_TOKEN=

# ---- Model provider ----
DEEPSEEK_API_KEY=__sk_from_dashboard__
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- Object store (artifacts + backup target) ----
MINIO_ACCESS_KEY=__change_me__
MINIO_SECRET_KEY=__change_me__

# ---- Web ----
CENTRAL_API_DOMAIN=api.example.com
CORS_ORIGINS=https://app.example.com,https://admin.example.com
COSA_MAX_REQUEST_BYTES=10485760

# ---- Metrics scrape allowlist (CIDR được phép gọi /metrics qua Caddy) ----
METRICS_ALLOW_CIDR=10.0.0.0/8

# ---- Migrate one-shot ----
MIGRATE_VERIFY_FINGERPRINT=true

# ---- Knowledge ingestion (chỉ bật khi đã có attestation control tương đương) ----
# docker compose --profile ingestion up -d
KNOWLEDGE_INGESTION_RESOURCE_LIMITS_ATTESTED=false
KNOWLEDGE_INGESTION_EGRESS_DENY_ATTESTED=false

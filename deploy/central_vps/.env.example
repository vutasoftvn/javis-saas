# ============================================================================
# COSA CENTRAL CONTROL PLANE - VPS ENVIRONMENT VARIABLES
# ============================================================================

# Database Configuration
POSTGRES_DB=cosa
POSTGRES_USER=cosa_central_admin
POSTGRES_PASSWORD=ChangeThisToAStrongPassword2026!

# Cryptographic Entitlement Master Secret
COSA_PLATFORM_SIGNING_SECRET=cosa_platform_master_signing_key_production_random_string_64chars

# Domain Names & Reverse Proxy
CENTRAL_API_DOMAIN=api.vutasoft.com
MARKETING_WILDCARD_DOMAIN=*.vutasoft.com
ACME_EMAIL=admin@vutasoft.com

# Environment
ENVIRONMENT=production

# AI Gateway (Kira AI - Default)
KIRAAI_API_KEY=sk-your-kiraai-api-key-here
KIRAAI_BASE_URL=https://api.kiraai.vn/v1
CHAT_DEFAULT_PROVIDER=kira_ai
CHAT_DEFAULT_MODEL=deepseek-v4-pro-free


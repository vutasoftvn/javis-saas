# ============================================================================
# COSA CENTRAL CONTROL PLANE - VPS ENVIRONMENT VARIABLES
# ============================================================================

# Database Configuration
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ChangeThisToAStrongPassword2026!
AGENT_APP_PASSWORD=ChangeThisAgentAppPassword2026!
AGENT_MIGRATOR_PASSWORD=ChangeThisAgentMigratorPassword2026!
COSA_APP_PASSWORD=ChangeThisCosaAppPassword2026!
COSA_MIGRATOR_PASSWORD=ChangeThisCosaMigratorPassword2026!
WORKSPACE_APP_PASSWORD=ChangeThisWorkspaceAppPassword2026!
WORKSPACE_MIGRATOR_PASSWORD=ChangeThisWorkspaceMigratorPassword2026!

# Cryptographic Entitlement Master Secret
COSA_PLATFORM_SIGNING_SECRET=cosa_platform_master_signing_key_production_random_string_64chars

# Domain Names & Reverse Proxy
CENTRAL_API_DOMAIN=api.vutasoft.com
MARKETING_WILDCARD_DOMAIN=*.vutasoft.com
ACME_EMAIL=admin@vutasoft.com

# Environment
ENVIRONMENT=production

# AI Gateway (Kira AI - Default)
KIRAAI_API_KEY=sk-your-kiraai-api-key-here
KIRAAI_BASE_URL=https://api.kiraai.vn/v1
CHAT_DEFAULT_PROVIDER=kira_ai
CHAT_DEFAULT_MODEL=deepseek-v4-pro-free

# COSA internal service-to-service wiring (event pipeline + Copilot dispatch)
# Shared HMAC secret between services-company relay and cosa-api event intake (>= 32 chars)
COSA_LOCAL_SERVICE_SECRET=
# Service token services-company -> cosa-api copilot routes, and cosa-worker -> services-company callback
COSA_SERVICE_TOKEN=
# Service token cosa-api scheduler -> cosa-worker
COSA_WORKER_SERVICE_TOKEN=

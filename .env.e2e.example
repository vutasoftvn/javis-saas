# E2E Golden Path Environment Configuration
ENVIRONMENT=development
APP_ENV=development
COSA_MODEL_PROVIDER=fake

# PostgreSQL URLs (host accessible for pytest)
AGENT_DATABASE_URL=postgresql+asyncpg://agent_app:change-me-agent-app@127.0.0.1:5432/agent
COSA_DATABASE_URL=postgresql://cosa_app:change-me-cosa-app@127.0.0.1:5432/cosa?sslmode=disable
WORKSPACE_DATABASE_URL=postgresql://workspace_app:change-me-workspace-app@127.0.0.1:5432/workspace?sslmode=disable

# Service URLs
COMPANY_SERVICE_URL=http://127.0.0.1:4000
COSA_CONTROL_PLANE_URL=http://127.0.0.1:4001
COSA_PLATFORM_CONTROL_PLANE_URL=http://127.0.0.1:4001
COSA_EXECUTION_PLANE_URL=http://127.0.0.1:4001
COSA_API_URL=http://127.0.0.1:8001

# Auth Secrets & Tokens
PLATFORM_JWT_SECRET=cosa-super-secret-platform-jwt-key-change-in-prod
WORKER_SERVICE_JWT_SECRET=cosa-worker-service-jwt-key-change-in-prod-min32chars
JWT_SECRET=cosa-dev-jwt-secret-do-not-use-in-prod
DEEPSEEK_API_KEY=fake-deepseek-key-for-e2e

# Knowledge Ingestion Gates
KNOWLEDGE_INGESTION_ENABLED=true
KNOWLEDGE_INGESTION_RESOURCE_LIMITS_ATTESTED=true
KNOWLEDGE_INGESTION_EGRESS_DENY_ATTESTED=true

FROM python:3.11-slim

RUN groupadd -g 1001 app && useradd -u 1001 -g app -m -s /bin/sh app

WORKDIR /app
COPY packages/agent/requirements.txt /app/packages/agent/requirements.txt
COPY apps/cosa/requirements.txt /app/apps/cosa/requirements.txt
RUN pip install --no-cache-dir -r /app/packages/agent/requirements.txt -r /app/apps/cosa/requirements.txt
COPY packages/agent /app/agent
COPY packages/agent_integrations /app/agent_integrations
COPY packages/agent_testkit /app/agent_testkit
COPY apps/cosa /app/apps/cosa
COPY skillpacks /app/skillpacks
COPY evals /app/evals
COPY docs/integrations/skill-source-attribution.md /app/docs/integrations/skill-source-attribution.md
RUN chown -R app:app /app

USER app
ENV PYTHONPATH=/app
CMD ["python", "-m", "apps.cosa.worker.main"]

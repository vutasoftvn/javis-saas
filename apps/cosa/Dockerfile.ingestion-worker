FROM python:3.11-slim

WORKDIR /app

# Install only ingestion-specific dependencies
# (NOT apps/cosa/requirements.txt — this image must not carry full API/worker deps)
COPY apps/cosa/requirements.ingestion.txt /app/apps/cosa/requirements.ingestion.txt
RUN pip install --no-cache-dir -r /app/apps/cosa/requirements.ingestion.txt

# Copy converter code
COPY apps/cosa/knowledge_ingestion /app/apps/cosa/knowledge_ingestion

ENV PYTHONPATH=/app

# Create non-root user for security
RUN useradd -m -u 1000 converter && chown -R converter:converter /app
USER converter

# Release-readiness gate — chạy TRƯỚC khi worker khởi động, fail-closed.
# assert_production_ingestion_ready() raise (exit != 0) nếu ENVIRONMENT=production
# mà thiếu: feature flag, storage prefix policy, scanner/sandbox backend thật,
# attestation egress-deny + resource-limits, hoặc converter spec khớp bản pin.
# KHÔNG dùng warning log — thiếu điều kiện là container không boot. `exec "$@"`
# chỉ chạy khi gate pass.
ENTRYPOINT ["sh", "-c", "python -c \"import os; from apps.cosa.knowledge_ingestion.conversion_sandbox import assert_production_ingestion_ready; assert_production_ingestion_ready(os.environ.get('ENVIRONMENT', 'production'))\" && exec \"$@\"", "--"]
CMD ["python", "-m", "apps.cosa.worker.main"]

# IMPORTANT: This Docker image provides development convenience only.
# Production deployment REQUIRES an orchestrator (Kubernetes, ECS, etc.)
# providing:
# - Read-only root filesystem
# - CPU/memory/PID/time resource limits
# - Network egress-deny policy (no outbound HTTP/DNS except to approved endpoints)
#
# These orchestrator-level controls are consumed by the readiness check
# (assert_production_conversion_ready) which verifies attestation env vars:
# - KNOWLEDGE_INGESTION_RESOURCE_LIMITS_ATTESTED=true
# - KNOWLEDGE_INGESTION_EGRESS_DENY_ATTESTED=true
#
# Docker Compose alone does NOT provide these security boundaries.

# ─────────────────────────────────────────────────────────────
# Javis SaaS - Services Cluster Environment Variables
# ─────────────────────────────────────────────────────────────

# Environment: development | staging | production
ENCORE_ENV=development
SERVICES_PORT=4000
SERVICES_DASHBOARD_PORT=9401
SERVICES_LIVEKIT_PORT=7885
SERVICES_LIVEKIT_TCP_PORT=7886

# JWT Secret for Auth & Identity tokens
JWT_SECRET=supersecret-dev-key

# LiveKit Configuration (Local Dev Defaults)
LIVEKIT_LOCAL_HTTP_URL=http://localhost:7880
LIVEKIT_LOCAL_URL=ws://localhost:7880
LIVEKIT_LOCAL_API_KEY=devkey
LIVEKIT_LOCAL_API_SECRET=secret_local_cosa_desktop_key

# Realtime Cloud fallback (optional)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret_local_cosa_desktop_key

# LLM & Voice Provider Keys
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Local PostgreSQL Configuration
POSTGRES_USER=cosa
POSTGRES_PASSWORD=cosa
POSTGRES_DB=company
DATABASE_URL=postgresql://cosa:cosa@postgres:5432/company

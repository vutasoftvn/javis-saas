# ─────────────────────────────────────────────────────────────
# Javis SaaS - Services Cluster Environment Variables
# (Task 3: Explicit Topology & Configuration Contract)
# ─────────────────────────────────────────────────────────────
#
# TOPOLOGY:
# - Company Service (Encore.ts): runs on host, port 4000
# - COSA Control Plane (Encore.ts): runs on host, port 4001
# - PostgreSQL: one local cluster; three isolated databases (`agent`, `cosa`, `workspace`)
# - FastAPI Worker: runs on host, port 8000
#
# ─────────────────────────────────────────────────────────────

# Environment: development | staging | production
ENCORE_ENV=development
SERVICES_PORT=4000
SERVICES_DASHBOARD_PORT=9401
SERVICES_LIVEKIT_PORT=7885
SERVICES_LIVEKIT_TCP_PORT=7886

# JWT Secret for Auth & Identity tokens
# Used by Company & COSA Control Plane services for signing JWTs
# Must match PLATFORM_JWT_SECRET in root .env.example
JWT_SECRET=dev-platform-jwt-secret-change-in-production

# LiveKit Configuration (Local Dev Defaults)
LIVEKIT_LOCAL_HTTP_URL=http://localhost:7880
LIVEKIT_LOCAL_URL=ws://localhost:7880
LIVEKIT_LOCAL_API_KEY=devkey
LIVEKIT_LOCAL_API_SECRET=secret_local_cosa_desktop_key

# Realtime Cloud fallback (optional)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret_local_cosa_desktop_key

# LLM & Voice Provider Keys
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Local PostgreSQL Configuration
WORKSPACE_POSTGRES_USER=postgres
WORKSPACE_POSTGRES_PASSWORD=dev-postgres-password
WORKSPACE_POSTGRES_DB=postgres
AGENT_DATABASE_URL=postgresql+asyncpg://agent_app:change-me-agent-app@postgres:5432/agent
AGENT_MIGRATOR_DATABASE_URL=postgresql+asyncpg://agent_migrator:change-me-agent-migrator@postgres:5432/agent
COSA_DATABASE_URL=postgresql://cosa_app:change-me-cosa-app@postgres:5432/cosa?sslmode=disable
COSA_MIGRATOR_DATABASE_URL=postgresql://cosa_migrator:change-me-cosa-migrator@postgres:5432/cosa?sslmode=disable
WORKSPACE_DATABASE_URL=postgresql://workspace_app:change-me-workspace-app@postgres:5432/workspace?sslmode=disable
WORKSPACE_MIGRATOR_DATABASE_URL=postgresql://workspace_migrator:change-me-workspace-migrator@postgres:5432/workspace?sslmode=disable

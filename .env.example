# Postgres (self-host, xem service `postgres` trong docker-compose.yml)
POSTGRES_USER=javis
POSTGRES_PASSWORD=javis
POSTGRES_DB=javis
# Dùng khi chạy alembic/app ngoài Docker (host trỏ localhost); bên trong docker-compose
# brain-api/agent-worker tự override DATABASE_URL trỏ tới service `postgres`.
DATABASE_URL=postgresql://javis:javis@localhost:5432/javis

# MinIO Object Storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Environment
SECRET_STORE_MODE=development

# DeepSeek - only agent-worker reads this credential. Leave blank until supplied
# through the local secret file or deployment secret manager.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-chat

# OpenRouter - gateway đa model, cũng chỉ agent-worker đọc. Mỗi provider dùng khoá
# CỦA CHÍNH NÓ: đừng nhét khoá OpenRouter vào DEEPSEEK_API_KEY rồi trỏ DEEPSEEK_BASE_URL
# sang OpenRouter, vì model id hai bên khác nhau ("deepseek-chat" và
# "deepseek/deepseek-chat") và gateway sẽ trả 400.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Provider/model mặc định cho chat session mới. Phải là một cặp có trong
# backend/app/modules/chat/model_registry.py, và brain-api với agent-worker phải cùng
# giá trị. Sai giá trị thì lùi về deepseek/deepseek-chat kèm cảnh báo trong log.
CHAT_DEFAULT_PROVIDER=deepseek
CHAT_DEFAULT_MODEL=deepseek-chat

# Ký JWT đăng nhập của brain-api (backend/app/core/security.py). Server Chat cũ
# (backend/server, ngoài Docker) verify token Flutter gửi lên bằng CHÍNH giá trị này -
# xem backend/.env: JWT_SECRET ở đó phải khớp giá trị dưới đây. Đổi ở production thì đổi cả 2 nơi.
JWT_SECRET=supersecret-dev-key

# --- Kết nối Gmail (OAuth2 Google) ---
# Lấy tại console.cloud.google.com: tạo project -> bật Gmail API -> Credentials ->
# OAuth client ID (loại "Web application") -> thêm Authorized redirect URI đúng bằng
# GOOGLE_REDIRECT_URI bên dưới. Màn hình đồng ý để "External" + thêm email của bạn vào
# Test users là đủ dùng nội bộ, không cần Google duyệt.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/connectors/google/oauth/callback

# Khoá mã hoá refresh token trước khi ghi DB. Production PHẢI đặt giá trị ngẫu nhiên riêng;
# đổi nó là mọi kết nối Gmail hiện có thành rác và người dùng phải đăng nhập lại.
MASTER_SECRET_KEY=

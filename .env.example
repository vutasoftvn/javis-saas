# ─────────────────────────────────────────────────────────────
# Development Stack Configuration (Task 3: Explicit Contract)
# ─────────────────────────────────────────────────────────────
# All of these are REQUIRED for `make dev-stack` to run.
# Use `make dev-preflight` to validate configuration before starting.

# Postgres credentials for Docker container (used only when starting services)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev-postgres-password
POSTGRES_DB=postgres
AGENT_APP_PASSWORD=change-me-agent-app
AGENT_MIGRATOR_PASSWORD=change-me-agent-migrator
COSA_APP_PASSWORD=change-me-cosa-app
COSA_MIGRATOR_PASSWORD=change-me-cosa-migrator
WORKSPACE_APP_PASSWORD=change-me-workspace-app
WORKSPACE_MIGRATOR_PASSWORD=change-me-workspace-migrator

# Agent database (PostgreSQL on localhost:5432)
# Host URL for processes running on the machine; Docker services use 'postgres:5432' on their network
AGENT_DATABASE_URL=postgresql+asyncpg://agent_app:change-me-agent-app@localhost:5432/agent

# COSA control-plane database (PostgreSQL on localhost:5432)
COSA_DATABASE_URL=postgresql://cosa_app:change-me-cosa-app@localhost:5432/cosa?sslmode=disable

# Workspace business database. `services/company` keeps its source name.
WORKSPACE_DATABASE_URL=postgresql://workspace_app:change-me-workspace-app@localhost:5432/workspace?sslmode=disable

# M2 §2 — Snowflake generator slot (0..1023) cho services/company. Guardrail 6:
# KHÔNG random node ID ở production. Bắt buộc set ở staging/prod (fail-closed nếu
# thiếu); test/dev mặc định 0. Mỗi process/replica phải có slot riêng biệt.
COMPANY_SNOWFLAKE_SLOT=0


# ─────────────────────────────────────────────────────────────
# Service URLs (Host Topology)
# ─────────────────────────────────────────────────────────────
# These must point to actual running services on the host/Docker.
# dev-preflight checks these endpoints for readiness.

# Company Service (Encore.ts running on host, port 4000)
COMPANY_SERVICE_URL=http://127.0.0.1:4000

# COSA Control Plane (Encore.ts running on host, port 4001)
# SPEC-EXEC-PLANE-SPLIT: hai plane tách bạch. Đặt cả hai biến dưới; biến
# COSA_CONTROL_PLANE_URL cũ chỉ còn là fallback DEPRECATED cho cả hai.
COSA_CONTROL_PLANE_URL=http://127.0.0.1:4001
# Local Workspace Runtime Node — durable run dispatch/lease/scheduled task.
# Fail-fast ở production nếu trỏ ra platform từ xa (không loopback/.local).
COSA_EXECUTION_PLANE_URL=http://127.0.0.1:4001
# VPS platform — identity/license, connector policy, company policy,
# document-ingestion control record.
COSA_PLATFORM_CONTROL_PLANE_URL=http://127.0.0.1:4001

# ─────────────────────────────────────────────────────────────
# JWT Secrets (for token signing)
# ─────────────────────────────────────────────────────────────
# These are used to sign/verify JWTs for inter-service communication.
# MUST be 32+ characters in production.

# Platform JWT secret (for Company/Control Plane auth)
PLATFORM_JWT_SECRET=dev-platform-jwt-secret-change-in-production

# Worker Service JWT secret (for COSA Worker authentication)
WORKER_SERVICE_JWT_SECRET=dev-worker-jwt-secret-change-in-production

# ─────────────────────────────────────────────────────────────
# COSA Worker Service Token
# ─────────────────────────────────────────────────────────────
# Generated using: WORKER_SERVICE_JWT_SECRET=... node scripts/mint-worker-service-token.mjs <worker-id>
# Must have claims: aud="control_plane", role="worker_service", exp=<future>
COSA_WORKER_SERVICE_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhdWQiOiJjb250cm9sX3BsYW5lIiwicm9sZSI6Indvcmtlcl9zZXJ2aWNlIiwic3ViIjoiZXhhbXBsZS13b3JrZXItaWQiLCJpc3MiOiJjb3NhX2NvbnRyb2xfcGxhbmUiLCJpYXQiOjE2OTI1Njc4MDAsImV4cCI6MTY5MjU3MTQwMH0.change-me-this-is-example-only


# MinIO Object Storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Environment
SECRET_STORE_MODE=development
# Comma-separated browser origins allowed to call COSA API.
# Leave blank for wildcard (*) in local development; must be explicitly configured in staging/production.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- AI Providers ---
# Kira AI Gateway (Cổng AI Việt Nam - Mặc định cho COSA OS, Free & Nhanh)
KIRAAI_API_KEY=
KIRAAI_BASE_URL=https://api.kiraai.vn/v1
KIRAAI_DEFAULT_MODEL=deepseek-v4-pro-free

# DeepSeek API (Trực tiếp)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-chat

# Google Gemini API
GEMINI_API_KEY=

# OpenAI API
OPENAI_API_KEY=

# OpenRouter Gateway
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Provider/model mặc định cho chat session mới.
CHAT_DEFAULT_PROVIDER=kira_ai
CHAT_DEFAULT_MODEL=deepseek-v4-pro-free

# Ký JWT đăng nhập của brain-api (backend/app/core/security.py). Server Chat cũ
# (backend/server, ngoài Docker) verify token Flutter gửi lên bằng CHÍNH giá trị này -
# xem backend/.env: JWT_SECRET ở đó phải khớp giá trị dưới đây. Đổi ở production thì đổi cả 2 nơi.
JWT_SECRET=supersecret-dev-key

# --- Kết nối Gmail (OAuth2 Google) ---
# Lấy tại console.cloud.google.com: tạo project -> bật Gmail API -> Credentials ->
# OAuth client ID (loại "Web application") -> thêm Authorized redirect URI đúng bằng
# GOOGLE_REDIRECT_URI bên dưới. Màn hình đồng ý để "External" + thêm email của bạn vào
# Test users là đủ dùng nội bộ, không cần Google duyệt.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/connectors/google/oauth/callback

# Khoá mã hoá refresh token trước khi ghi DB. Production PHẢI đặt giá trị ngẫu nhiên riêng;
# đổi nó là mọi kết nối Gmail hiện có thành rác và người dùng phải đăng nhập lại.
MASTER_SECRET_KEY=

# --- LiveKit Realtime Voice ---
# Cloud (mặc định cho Mobile & Fallback)
LIVEKIT_URL=wss://example.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Local (Desktop macOS Docker SFU)
LIVEKIT_LOCAL_URL=ws://127.0.0.1:7880
LIVEKIT_LOCAL_API_KEY=devkey
LIVEKIT_LOCAL_API_SECRET=secret_local_cosa_desktop_key
LIVEKIT_LOCAL_HTTP_URL=http://127.0.0.1:7880

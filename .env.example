# Postgres (self-host, xem service `postgres` trong docker-compose.yml)
# `javis` (superuser) chỉ dùng để vận hành thủ công (tạo role/DB, reset) — ứng
# dụng KHÔNG dùng credential này nữa (rủi ro 1 role superuser dùng chung cho
# mọi service). Role thật của app là `javis_app` (không superuser, xem
# deploy/postgres/init/01-create-app-roles.sql), đổi mật khẩu placeholder bên
# dưới trước khi deploy thật.
POSTGRES_USER=javis
POSTGRES_PASSWORD=javis
POSTGRES_DB=javis
# Dùng khi chạy alembic/app ngoài Docker (host trỏ localhost); bên trong docker-compose
# brain-api/agent-worker tự override DATABASE_URL trỏ tới service `postgres`.
DATABASE_URL=postgresql://javis_app:change-me-javis-app@localhost:5432/javis

# Central Control Plane — database RIÊNG (cosa_control_plane), role RIÊNG
# (cosa_control_plane_app), không còn co-locate chung DB/role với Local
# Business nữa (đã tách vật lý — xem deploy/postgres/init/01-create-app-roles.sql).
# Hostinger (hiện tại): DB riêng nhưng vẫn cùng 1 Postgres instance/container `postgres`.
CONTROL_PLANE_DATABASE_URL=postgresql://cosa_control_plane_app:change-me-control-plane-app@postgres:5432/cosa_control_plane
# Viettel vDBS (tương lai): chỉ cần đổi dòng này, không đổi gì khác
# CONTROL_PLANE_DATABASE_URL=postgresql://user:pass@vdbs-internal.viettel.vn:5432/cosa_control_plane


# MinIO Object Storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Environment
SECRET_STORE_MODE=development
# Comma-separated browser origins allowed to call brain-api in development.
# Leave blank to use the local Flutter Web defaults.
CORS_ALLOWED_ORIGINS=

# --- AI Providers ---
# Kira AI Gateway (Cổng AI Việt Nam - Mặc định cho COSA OS, Free & Nhanh)
KIRAAI_API_KEY=
KIRAAI_BASE_URL=https://api.kiraai.vn/v1
KIRAAI_DEFAULT_MODEL=deepseek-v4-pro-free

# DeepSeek API (Trực tiếp)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-chat

# Google Gemini API
GEMINI_API_KEY=

# OpenAI API
OPENAI_API_KEY=

# OpenRouter Gateway
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Provider/model mặc định cho chat session mới.
CHAT_DEFAULT_PROVIDER=kira_ai
CHAT_DEFAULT_MODEL=deepseek-v4-pro-free

# Ký JWT đăng nhập của brain-api (backend/app/core/security.py). Server Chat cũ
# (backend/server, ngoài Docker) verify token Flutter gửi lên bằng CHÍNH giá trị này -
# xem backend/.env: JWT_SECRET ở đó phải khớp giá trị dưới đây. Đổi ở production thì đổi cả 2 nơi.
JWT_SECRET=supersecret-dev-key

# --- Kết nối Gmail (OAuth2 Google) ---
# Lấy tại console.cloud.google.com: tạo project -> bật Gmail API -> Credentials ->
# OAuth client ID (loại "Web application") -> thêm Authorized redirect URI đúng bằng
# GOOGLE_REDIRECT_URI bên dưới. Màn hình đồng ý để "External" + thêm email của bạn vào
# Test users là đủ dùng nội bộ, không cần Google duyệt.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/connectors/google/oauth/callback

# Khoá mã hoá refresh token trước khi ghi DB. Production PHẢI đặt giá trị ngẫu nhiên riêng;
# đổi nó là mọi kết nối Gmail hiện có thành rác và người dùng phải đăng nhập lại.
MASTER_SECRET_KEY=

# --- LiveKit Realtime Voice ---
# Cloud (mặc định cho Mobile & Fallback)
LIVEKIT_URL=wss://example.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Local (Desktop macOS Docker SFU)
LIVEKIT_LOCAL_URL=ws://127.0.0.1:7880
LIVEKIT_LOCAL_API_KEY=devkey
LIVEKIT_LOCAL_API_SECRET=secret_local_cosa_desktop_key
LIVEKIT_LOCAL_HTTP_URL=http://127.0.0.1:7880

